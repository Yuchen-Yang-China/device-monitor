<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <PublishDirectory Condition="'$(PublishDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\win-x64</PublishDirectory>
    <OutputName>Device Monitor</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(PublishDirectory)" BindName="Published" />
  </ItemGroup>
</Project>
