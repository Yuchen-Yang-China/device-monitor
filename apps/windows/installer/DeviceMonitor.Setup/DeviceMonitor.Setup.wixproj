<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputType>Bundle</OutputType>
    <OutputName>Device Monitor Setup</OutputName>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\installer\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeviceMonitor.Package\DeviceMonitor.Package.wixproj" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
