<Application x:Class="DeviceMonitor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeviceMonitor.App"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFF7F7F7"/>
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF666666"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Application.Resources>
</Application>
