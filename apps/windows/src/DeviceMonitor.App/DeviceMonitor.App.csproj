<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DeviceMonitor.Core\DeviceMonitor.Core.csproj" />
    <ProjectReference Include="..\DeviceMonitor.Protocol\DeviceMonitor.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.3.0</Version>
    <AssemblyName>Device Monitor</AssemblyName>
    <ApplicationIcon>..\..\..\..\shared\assets\windows\DeviceMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\..\..\shared\assets\windows\DeviceMonitor.ico" Link="Assets\DeviceMonitor.ico" />
    <None Include="..\..\..\..\shared\assets\windows\DeviceMonitor-1024.png" Link="Assets\DeviceMonitor-1024.png" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
