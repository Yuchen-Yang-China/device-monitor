<Window x:Class="DeviceMonitor.App.StatusFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Monitor" Icon="Assets/DeviceMonitor.ico"
        Width="332" Height="260" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#FF18212F"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="9" Background="#FCFFFFFF" BorderBrush="#220B1220" BorderThickness="1" CornerRadius="17">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.28" Color="#FF0F172A"/></Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="Auto"/><RowDefinition Height="11"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="#FFEDF4FB" CornerRadius="10" Margin="0,0,9,0">
                    <Grid Width="27" Height="24">
                        <Border Width="7" Height="22" HorizontalAlignment="Left" Background="#FFDDE5EC" CornerRadius="3" VerticalAlignment="Bottom"><Rectangle x:Name="FlyoutCpuBar" Height="4" Fill="#FF3B82F6" RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/></Border>
                        <Border Width="7" Height="22" HorizontalAlignment="Center" Background="#FFDDE5EC" CornerRadius="3" VerticalAlignment="Bottom"><Rectangle x:Name="FlyoutMemoryBar" Height="4" Fill="#FF3B82F6" RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/></Border>
                        <Border Width="7" Height="22" HorizontalAlignment="Right" Background="#FFDDE5EC" CornerRadius="3" VerticalAlignment="Bottom"><Rectangle x:Name="FlyoutStorageBar" Height="4" Fill="#FF94A3B8" RadiusX="3" RadiusY="3" VerticalAlignment="Bottom"/></Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Device Monitor" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="SubtitleText" Foreground="#FF64748B" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#FF16A163" Margin="0,0,5,0"/><TextBlock x:Name="LiveText" Foreground="#FF16834A" FontSize="10" FontWeight="SemiBold"/></StackPanel>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="#FFF2F6FA" CornerRadius="11" Padding="10,8"><StackPanel><TextBlock x:Name="UploadLabel" Foreground="#FF64748B" FontSize="9"/><TextBlock x:Name="UploadValue" Foreground="#FF16834A" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#FFF2F6FA" CornerRadius="11" Padding="10,8"><StackPanel><TextBlock x:Name="DownloadLabel" Foreground="#FF64748B" FontSize="9"/><TextBlock x:Name="DownloadValue" Foreground="#FF1671C5" FontFamily="Cascadia Mono, Consolas" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
                <TextBlock Text="CPU" VerticalAlignment="Center" FontSize="11"/><Grid Grid.Column="1" Height="6" ClipToBounds="True" Background="#FFE8EDF2"><Border x:Name="CpuIndicator" Background="#FF3B82F6" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="CpuScale" ScaleX="0"/></Border.RenderTransform></Border></Grid><TextBlock x:Name="CpuValue" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock x:Name="MemoryLabel" Grid.Row="1" VerticalAlignment="Center" FontSize="11"/><Grid Grid.Row="1" Grid.Column="1" Height="6" ClipToBounds="True" Background="#FFE8EDF2"><Border x:Name="MemoryIndicator" Background="#FF3B82F6" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="MemoryScale" ScaleX="0"/></Border.RenderTransform></Border></Grid><TextBlock x:Name="MemoryValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"/>
                <TextBlock Text="SSD" Grid.Row="2" VerticalAlignment="Center" FontSize="11"/><Grid Grid.Row="2" Grid.Column="1" Height="6" ClipToBounds="True" Background="#FFE8EDF2"><Border x:Name="StorageIndicator" Background="#FF94A3B8" CornerRadius="3" RenderTransformOrigin="0,0.5"><Border.RenderTransform><ScaleTransform x:Name="StorageScale" ScaleX="0"/></Border.RenderTransform></Border></Grid><TextBlock x:Name="StorageValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold"/>
            </Grid>
            <Border Grid.Row="5" BorderBrush="#FFE5EAF0" BorderThickness="0,1,0,0" Padding="0,9,0,0"><TextBlock x:Name="HintText" HorizontalAlignment="Center" Foreground="#FF718096" FontSize="9"/></Border>
        </Grid>
    </Border>
</Window>
