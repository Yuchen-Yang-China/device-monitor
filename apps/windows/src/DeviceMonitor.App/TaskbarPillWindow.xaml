<Window x:Class="DeviceMonitor.App.TaskbarPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="158" Height="42" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False"
        WindowStartupLocation="Manual" FontFamily="Segoe UI Variable Text, Segoe UI">
    <Button x:Name="PillButton" Click="PillButton_Click" Focusable="False"
            Padding="0" Margin="0" BorderThickness="0" Background="Transparent">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="#F8FFFFFF" BorderBrush="#220B1220"
                        BorderThickness="1" CornerRadius="11" Padding="8,5">
                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.20" Color="#FF0F172A"/></Border.Effect>
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFFFFFFF"/><Setter TargetName="Surface" Property="BorderBrush" Value="#440F6CBD"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFEAF3FB"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="1"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="34" Height="28" VerticalAlignment="Center" AutomationProperties.Name="CPU, memory, and SSD status">
                <Border Width="8" Height="25" HorizontalAlignment="Left" Background="#FFE7EBF0" CornerRadius="4" VerticalAlignment="Bottom"><Rectangle x:Name="CpuBar" Height="4" Fill="#FF3B82F6" RadiusX="4" RadiusY="4" VerticalAlignment="Bottom"/></Border>
                <Border Width="8" Height="25" HorizontalAlignment="Center" Background="#FFE7EBF0" CornerRadius="4" VerticalAlignment="Bottom"><Rectangle x:Name="MemoryBar" Height="4" Fill="#FF3B82F6" RadiusX="4" RadiusY="4" VerticalAlignment="Bottom"/></Border>
                <Border Width="8" Height="25" HorizontalAlignment="Right" Background="#FFE7EBF0" CornerRadius="4" VerticalAlignment="Bottom"><Rectangle x:Name="StorageBar" Height="4" Fill="#FF94A3B8" RadiusX="4" RadiusY="4" VerticalAlignment="Bottom"/></Border>
            </Grid>
            <Border Grid.Column="1" Width="1" Height="24" Background="#FFE4E7EC"/>
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <TextBlock x:Name="UploadText" Foreground="#FF16834A" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Text="↑ --"/>
                <TextBlock x:Name="DownloadText" Foreground="#FF1671C5" FontFamily="Cascadia Mono, Consolas" FontSize="10" FontWeight="SemiBold" Text="↓ --" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>
    </Button>
</Window>
